# Copy this file to .env and fill in real values before deploying.
# .env is gitignored — never commit real secrets.

# ── App ─────────────────────────────────────────────────────
APP_ENV=production
APP_URL=https://yourdomain.com
APP_KEY=change_this_to_a_random_64_char_string

# ── Admin onboarding ────────────────────────────────────────
# Required to register or log in as an admin. Generate a real random
# value for production — do not use the default.
ADMIN_INVITE_CODE=change_this_admin_code

# ── Database ────────────────────────────────────────────────
# SQLite (default, zero-config, fine for small/medium single-server
# deployments). Leave DB_DRIVER=sqlite to keep using it.
DB_DRIVER=sqlite
DB_PATH=api/database.sqlite

# To use MySQL/PostgreSQL instead (recommended once you outgrow a
# single server), set DB_DRIVER=mysql and fill these in — see
# api/migrate-to-mysql.sql for the schema conversion.
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=gitacademy
# DB_USER=gitacademy
# DB_PASS=

# ── Email (SMTP) ────────────────────────────────────────────
# Real transactional email (password reset, receipts, notifications).
# Works with Gmail SMTP, SendGrid, Mailgun, Postmark, AWS SES SMTP, etc.
# Leave MAIL_HOST blank to run in demo mode (emails are logged to
# api/storage/mail.log instead of sent).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@yourdomain.com
MAIL_FROM_NAME="GITAcademy"

# ── Payments (Paystack) ─────────────────────────────────────
# Real card/Mobile Money payments via Paystack (supports GHS).
# Get keys from https://dashboard.paystack.com/#/settings/developer
# Leave blank to run checkout in demo mode (orders are marked paid
# immediately, no real charge occurs).
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ── File storage ────────────────────────────────────────────
# Local disk storage (default, works out of the box).
UPLOADS_DRIVER=local
UPLOADS_PATH=uploads
UPLOADS_MAX_MB=200

# To use S3-compatible cloud storage instead once you need to scale:
# UPLOADS_DRIVER=s3
# S3_BUCKET=
# S3_REGION=
# S3_KEY=
# S3_SECRET=
# S3_ENDPOINT=
